---
import { Image } from "astro:assets";
import astroLogo from "../assets/images/brands_logo/astro_white.webp";
import claudeLogo from "../assets/images/brands_logo/claude_white.webp";
import geminiLogo from "../assets/images/brands_logo/gemini_white.webp";
import laravelLogo from "../assets/images/brands_logo/laravel_white.webp";
import nextjsLogo from "../assets/images/brands_logo/nextjs_white.webp";
import nodeLogo from "../assets/images/brands_logo/node_white.webp";
import openaiLogo from "../assets/images/brands_logo/openia_white.webp";
import playwrightLogo from "../assets/images/brands_logo/playwrite_white.webp";
import reactLogo from "../assets/images/brands_logo/react_white.webp";
import wpLogo from "../assets/images/brands_logo/wp_white.webp";

const brandLogos = [
  { src: reactLogo, alt: "React" },
  { src: nextjsLogo, alt: "Next.js" },
  { src: laravelLogo, alt: "Laravel" },
  { src: nodeLogo, alt: "Node.js" },
  { src: astroLogo, alt: "Astro" },
  { src: wpLogo, alt: "WordPress" },
  { src: playwrightLogo, alt: "Playwright" },
  { src: openaiLogo, alt: "OpenAI" },
  { src: claudeLogo, alt: "Claude" },
  { src: geminiLogo, alt: "Gemini" },
];
---

<div
  class="relative w-full overflow-hidden border-y border-white/[0.07] py-5 [-webkit-mask-image:linear-gradient(to_right,transparent,black_9%,black_91%,transparent)] [mask-image:linear-gradient(to_right,transparent,black_9%,black_91%,transparent)]"
  aria-label="Tecnologías y herramientas"
>
  <div
    class="tech-stack-track flex w-max items-center gap-11 pr-11 sm:gap-14 sm:pr-14"
  >
    {
      [false, true].map((isDuplicate) => (
        <div
          class="flex shrink-0 items-center gap-11 sm:gap-14"
          aria-hidden={isDuplicate ? "true" : undefined}
        >
          {brandLogos.map((logo) => (
            <Image
              src={logo.src}
              alt={isDuplicate ? "" : logo.alt}
              width={92}
              height={32}
              loading="lazy"
              class="h-5 w-auto max-w-20 object-contain opacity-45 grayscale transition duration-300 hover:opacity-90 sm:h-6 sm:max-w-24"
            />
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  @keyframes tech-stack-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .tech-stack-track {
    animation: tech-stack-scroll 38s linear infinite;
  }

  .tech-stack-track:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-stack-track {
      animation: none;
    }
  }
</style>
