---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import felixImage from "../assets/images/home/felix-marquez-image.webp";
import isoFelix from "../assets/images/iso-felix.png";
import TechStack from "./TechStack.astro";
import ArrowLink from "./ui/ArrowLink.astro";

const stages = [
  {
    number: "01",
    title: "Necesidad",
    description:
      "Identifico usuarios, procesos, restricciones y el problema que realmente debe resolverse.",
    icon: "lucide:scan-search",
  },
  {
    number: "02",
    title: "Definición",
    description:
      "Organizo requerimientos, alcance y decisiones antes de convertirlos en tareas de desarrollo.",
    icon: "lucide:waypoints",
  },
  {
    number: "03",
    title: "Producto",
    description:
      "Construyo interfaces, flujos, APIs e integraciones como partes de una misma solución.",
    icon: "lucide:boxes",
  },
  {
    number: "04",
    title: "Entrega",
    description:
      "Preparo ambientes, servicios y documentación para que el producto pueda utilizarse y mantenerse.",
    icon: "lucide:package-check",
  },
];
---

<section
  id="inicio"
  class="relative isolate overflow-hidden border-b border-line pt-20"
  data-motion="hero"
>
  <!-- Background Glows -->
  <div
    class="surface-grid absolute inset-0 -z-30 opacity-40 [mask-image:linear-gradient(to_bottom,black_0%,black_70%,transparent_100%)]"
  >
  </div>
  <div
    class="absolute -top-32 left-1/4 -z-20 size-96 rounded-full bg-electric/10 blur-3xl"
  >
  </div>
  <div
    class="absolute top-20 right-10 -z-20 size-96 rounded-full bg-signal/5 blur-3xl"
  >
  </div>

  <div
    class="site-container block md:grid items-center gap-12 py-12 lg:grid-cols-2 lg:py-20"
  >
    <!-- Left Column: Copy & Actions -->
    <div class="relative z-10">
      <p class="eyebrow mb-4 sm:mb-6" data-motion-hero-item>
        React · Next.js · TypeScript · Laravel
      </p>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-paper leading-tight lg:leading-none max-w-2xl"
        data-motion-hero-item
      >
        Desarrollador Full Stack{" "}
        <span class="block text-gradient">orientado a producto</span>
        y soluciones
      </h1>

      <div
        class="mt-6 max-w-xl space-y-4 text-base sm:text-lg text-copy leading-relaxed"
        data-motion-hero-item
      >
        <p>
          Convierto necesidades de negocio en productos web concretos. Trabajo
          desde la definición y la experiencia de usuario hasta las APIs, las
          integraciones y la preparación para producción.
        </p>
        <p>
          Mi base profesional está en frontend con React y Next.js, respaldada
          por experiencia full stack con Laravel, Livewire, bases de datos,
          Docker y sistemas existentes.
        </p>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-motion-hero-item>
        <ArrowLink href="#proyectos" label="Ver proyectos" />
        <ArrowLink
          href="/Felix_Marquez_CV_Full_Stack.pdf"
          label="Descargar CV"
          variant="secondary"
          download="Felix_Marquez_CV_Full_Stack.pdf"
          target="_blank"
        />
      </div>

      <a
        href="#contacto"
        class="group mt-6 inline-flex items-center gap-2.5 text-xs sm:text-sm text-copy transition hover:text-paper"
        data-motion-hero-item
      >
        <span
          class="size-1.5 rounded-full bg-lime shadow-[0_0_16px_rgba(183,243,74,0.7)]"
        ></span>
        ¿Tienes un proyecto? Cuéntame qué necesitas.
        <Icon
          name="lucide:arrow-right"
          class="size-4 transition group-hover:translate-x-1"
        />
      </a>

      <div class="mt-8 max-w-xl" data-motion-hero-item>
        <TechStack />
      </div>
    </div>

    <!-- Right Column: Portrait & Badge -->
    <div
      class="relative flex justify-center lg:justify-end"
      data-motion-hero-media
    >
      <div class="relative w-full max-w-sm sm:max-w-md lg:max-w-lg">
        <!-- Radial blur behind portrait -->
        <div
          class="absolute inset-0 -z-10 rounded-full bg-electric/15 blur-3xl"
        >
        </div>

        <Image
          src={felixImage}
          alt="Retrato profesional de Félix Márquez"
          width={938}
          height={1021}
          quality={90}
          format="png"
          loading="eager"
          fetchpriority="high"
          class="w-full h-auto object-contain mt-10 md:mt-0"
        />

        <!-- Soft bottom gradient to merge into dark background -->
        <div
          class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink to-transparent"
        >
        </div>

        <!-- Floating Badge -->
        <div
          class="absolute bottom-4 left-4 right-4 sm:left-2 sm:right-auto lg:-left-6 flex items-center gap-3 border border-white/10 bg-ink/90 p-3.5 backdrop-blur shadow-panel"
        >
          <Image
            src={isoFelix}
            alt="Isotipo Félix Márquez"
            width={36}
            height={36}
            class="size-8 shrink-0 object-contain"
            loading="eager"
          />
          <div>
            <p
              class="font-mono text-[0.62rem] uppercase tracking-widest text-signal"
            >
              Producto + ingeniería
            </p>
            <p class="mt-0.5 text-xs sm:text-sm font-semibold text-paper">
              Una misma visión, de punta a punta.
            </p>
          </div>
        </div>
      </div>

      <!-- Subtle vertical accent on desktop -->
      <p
        class="absolute -right-6 top-32 hidden rotate-90 font-mono text-[0.6rem] uppercase tracking-widest text-copy/40 xl:block"
      >
        Buenos Aires · Argentina
      </p>
    </div>
  </div>

 
</section>
