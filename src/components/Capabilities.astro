---
import { Icon } from "astro-icon/components";
import ArrowLink from "./ui/ArrowLink.astro";
import SectionHeading from "./ui/SectionHeading.astro";

const capabilities = [
  {
    number: "01",
    title: "Producto y definición",
    description:
      "Convierto información dispersa en requerimientos, flujos y decisiones que el equipo pueda implementar.",
    metaLabel: "Áreas",
    meta: "descubrimiento · alcance · prioridades · experiencia de usuario · documentación",
    icon: "lucide:route",
  },
  {
    number: "02",
    title: "Frontend y experiencia",
    description:
      "Construyo interfaces y aplicaciones web con atención al flujo del usuario, el rendimiento y la mantenibilidad.",
    metaLabel: "Tecnologías",
    meta: "React · Next.js · TypeScript · Astro · Tailwind CSS",
    icon: "lucide:panels-top-left",
  },
  {
    number: "03",
    title: "Backend e integraciones",
    description:
      "Desarrollo y conecto APIs, lógica de negocio, autenticación, bases de datos y servicios externos.",
    metaLabel: "Tecnologías",
    meta: "Laravel · PHP · Livewire · APIs REST · MySQL · SQL Server",
    icon: "lucide:network",
  },
  {
    number: "04",
    title: "Arquitectura y entrega",
    description:
      "Trabajo con las piezas necesarias para llevar una aplicación más allá del entorno local y preparar una entrega reproducible.",
    metaLabel: "Tecnologías",
    meta: "Docker · VPS Ubuntu · Nginx · Redis · almacenamiento de objetos · Git",
    icon: "lucide:container",
  },
];
---

<section id="capacidades" class="section-shell overflow-hidden bg-ink">
  <div
    class="absolute inset-y-0 right-0 w-1/2 bg-[radial-gradient(circle_at_center,rgba(36,107,253,0.09),transparent_62%)]"
  >
  </div>
  <div class="site-container relative">
    <SectionHeading
      eyebrow="De la definición a la entrega"
      title="Puedo moverme entre las capas sin perder de vista el producto"
      description="No todas las soluciones necesitan la misma arquitectura. Mi trabajo consiste en comprender el problema, conectar las piezas necesarias y mantener la complejidad bajo control."
    />

    <div class="mt-16 border-y border-line">
      {
        capabilities.map((capability) => (
          <article
            class="group grid gap-7 border-b border-line py-9 last:border-b-0 md:grid-cols-[5rem_1fr_1.2fr] md:items-start md:gap-10"
            data-motion="item"
          >
            <div class="flex items-center justify-between md:block">
              <span class="font-mono text-xs text-copy/45">
                {capability.number}
              </span>
              <div class="grid size-11 place-items-center border border-line text-signal transition duration-500 group-hover:border-signal/50 group-hover:bg-signal/5 md:mt-6">
                <Icon name={capability.icon} class="size-5" />
              </div>
            </div>
            <div>
              <h3 class="text-2xl font-semibold tracking-[-0.035em] text-paper md:text-3xl">
                {capability.title}
              </h3>
              <p class="mt-4 max-w-lg text-base leading-7 text-copy">
                {capability.description}
              </p>
            </div>
            <div class="border-l border-line pl-6">
              <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-signal">
                {capability.metaLabel}
              </p>
              <p class="mt-3 text-sm leading-6 text-copy-light">
                {capability.meta}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10" data-motion="item">
      <ArrowLink
        href="#proyectos"
        label="Ver estas capacidades aplicadas en proyectos"
        variant="secondary"
      />
    </div>
  </div>
</section>
