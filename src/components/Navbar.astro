---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logoFelix from "../assets/images/felix-marquez-logo-md.webp";
import isoFelix from "../assets/images/iso-felix.png";

const links = [
  { label: "Proyectos", href: "#proyectos" },
  { label: "Capacidades", href: "#capacidades" },
  { label: "Experiencia", href: "#experiencia" },
  // { label: "Servicios", href: "#servicios" },
  { label: "Sobre mí", href: "#sobre-mi" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-ink/80 backdrop-blur-xl"
  data-motion="header"
>
  <div class="site-container flex h-20 items-center justify-between gap-6">
    <a
      href="#inicio"
      class="group flex items-center transition duration-300 hover:opacity-90"
      aria-label="Félix Márquez, volver al inicio"
    >
      <Image
        src={isoFelix}
        alt="Félix Márquez"
        width={36}
        height={36}
        loading="eager"
        class="size-9 object-contain sm:hidden"
      />
      <Image
        src={logoFelix}
        alt="Félix Márquez — Software Engineer"
        width={185}
        height={34}
        loading="eager"
        class="hidden h-8 w-auto object-contain sm:block"
      />
    </a>

    <nav
      class="hidden items-center gap-5 xl:flex"
      aria-label="Navegación principal"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-[0.82rem] font-medium text-copy transition hover:text-paper"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a
        href="#contacto"
        class="inline-flex min-h-11 items-center gap-2 px-3 text-xs font-semibold text-copy-light transition hover:text-signal"
      >
        <Icon name="lucide:download" class="size-4" />
        Descargar CV
      </a>
      <a
        href="#contacto"
        class="inline-flex min-h-11 items-center rounded-md bg-paper px-5 text-xs font-bold text-ink transition hover:bg-signal"
      >
        Contactar
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary
        class="grid size-11 cursor-pointer list-none place-items-center border border-white/15 bg-white/[0.04] text-paper [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú"
      >
        <Icon name="lucide:menu" class="size-5 group-open:hidden" />
        <Icon name="lucide:x" class="hidden size-5 group-open:block" />
      </summary>
      <nav
        class="absolute right-0 top-14 w-64 border border-line bg-ink-soft p-3 shadow-panel"
        aria-label="Navegación móvil"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class="block border-b border-line px-3 py-3 text-sm text-copy-light last:border-0"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="#contacto"
          class="mt-3 flex min-h-11 items-center justify-center rounded-md bg-paper px-4 text-sm font-bold text-ink"
          >Contactar</a
        >
      </nav>
    </details>
  </div>
</header>
