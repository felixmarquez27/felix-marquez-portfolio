---
import { Icon } from "astro-icon/components";
import SectionHeading from "./ui/SectionHeading.astro";

const projects = [
  {
    number: "01",
    category: "Aplicación de negocio",
    description:
      "Diseño e implementación de una aplicación web que conecta experiencia de usuario, lógica de negocio, servicios y despliegue dentro de una solución completa.",
    role: "[RESPONSABILIDAD_EN_EL_PROYECTO]",
    stack: "[STACK_CONFIRMADO]",
    status: "[ESTADO_REAL_DEL_PROYECTO]",
  },
  {
    number: "02",
    category: "Integración de sistemas",
    description:
      "Integración de una aplicación Laravel con un entorno legacy basado en Microsoft SQL Server, manteniendo separadas las responsabilidades y los datos internos de la nueva aplicación.",
    role: "análisis, integración de aplicación, conectividad y preparación del entorno de pruebas.",
    stack: "Laravel · SQL Server · Docker · PHP",
    status: "[ESTADO_REAL_DEL_PROYECTO]",
  },
  {
    number: "03",
    category: "Arquitectura y despliegue",
    description:
      "Arquitectura de una aplicación con frontend, backend, procesos asíncronos, almacenamiento externo y ambientes separados para acompañar su evolución.",
    role: "[RESPONSABILIDAD_EN_EL_PROYECTO]",
    stack: "Next.js · Laravel · Docker · Redis · Nginx",
    status: "[ESTADO_REAL_DEL_PROYECTO]",
  },
];
---

<section id="proyectos" class="section-shell overflow-hidden bg-ink-soft">
  <div
    class="surface-grid absolute inset-0 opacity-25 [mask-image:radial-gradient(circle_at_center,black,transparent_72%)]"
  >
  </div>
  <div class="site-container relative">
    <SectionHeading
      eyebrow="Trabajo seleccionado"
      title="Proyectos donde la solución importa tanto como el código"
      description="Cada caso documentará el problema, mi participación, las decisiones técnicas, el estado real del producto y lo que puede verificarse públicamente."
    />

    <div class="mt-16 grid gap-5 lg:grid-cols-12">
      {
        projects.map((project, index) => (
          <article
            class:list={[
              "group relative flex min-h-[31rem] flex-col overflow-hidden border border-line bg-ink p-7 transition duration-500 hover:-translate-y-1 hover:border-signal/35 md:p-9",
              index === 0 ? "lg:col-span-6" : "lg:col-span-3",
            ]}
            data-motion="item"
          >
            <div class="absolute right-0 top-0 size-40 bg-[radial-gradient(circle_at_top_right,rgba(65,215,232,0.12),transparent_65%)] opacity-0 transition duration-500 group-hover:opacity-100" />
            <div class="flex items-center justify-between">
              <span class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-signal">
                {project.category}
              </span>
              <span class="font-mono text-xs text-copy/45">
                {project.number}
              </span>
            </div>
            <div class="my-8 h-px bg-line">
              <div class="h-px w-12 bg-electric transition-all duration-500 group-hover:w-full group-hover:bg-signal" />
            </div>
            <p
              class:list={[
                "font-medium leading-snug tracking-[-0.03em] text-paper",
                index === 0 ? "text-3xl md:text-4xl" : "text-2xl",
              ]}
            >
              {project.description}
            </p>
            <dl class="mt-auto space-y-4 pt-10 text-xs leading-5">
              <div>
                <dt class="font-mono uppercase tracking-[0.15em] text-copy/45">
                  Participación
                </dt>
                <dd class="mt-1 text-copy-light">{project.role}</dd>
              </div>
              <div>
                <dt class="font-mono uppercase tracking-[0.15em] text-copy/45">
                  Tecnologías
                </dt>
                <dd class="mt-1 text-copy-light">{project.stack}</dd>
              </div>
              <div>
                <dt class="font-mono uppercase tracking-[0.15em] text-copy/45">
                  Estado
                </dt>
                <dd class="mt-1 text-copy-light">{project.status}</dd>
              </div>
            </dl>
            <span
              class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-copy/60"
              aria-disabled="true"
            >
              Ver proyecto
              <Icon name="lucide:lock-keyhole" class="size-3.5" />
            </span>
          </article>
        ))
      }
    </div>

    <div class="mt-8 text-right" data-motion="item">
      <span
        class="inline-flex items-center gap-3 text-sm font-semibold text-copy/60"
        aria-disabled="true"
      >
        Ver todos los proyectos
        <Icon name="lucide:arrow-up-right" class="size-4" />
      </span>
    </div>
  </div>
</section>
