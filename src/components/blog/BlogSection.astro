---
import { Icon } from "astro-icon/components";
import type { BlogPost } from "../../services/blogService";
import BlogCard from "./BlogCard.astro";

interface Props {
  allArticles: BlogPost[];
  allTags: string[];
  itemsPerPage?: number;
}

const { allArticles, allTags, itemsPerPage = 6 } = Astro.props;
---

<section class="py-14 sm:py-20 bg-ink relative" id="blog-articles">
  <div class="site-container relative z-10">
    {/* Search Bar */}
    <div class="mx-auto max-w-2xl mb-10">
      <div class="relative">
        <span
          class="absolute left-4 top-1/2 -translate-y-1/2 text-copy pointer-events-none"
        >
          <Icon name="lucide:search" class="size-5" />
        </span>
        <input
          type="text"
          id="blogSearch"
          placeholder="Buscar artículos por título, tema o descripción..."
          class="w-full rounded-xl border border-line bg-panel pl-12 pr-4 py-3.5 text-sm text-paper placeholder:text-copy/50 transition focus:border-signal focus:outline-none"
          autocomplete="off"
        />
      </div>
    </div>

    {/* Tag Filters */}
    <div
      class="flex flex-wrap items-center justify-center gap-2 mb-12"
      id="tagFilters"
    >
      <button
        type="button"
        data-tag="all"
        class="tag-filter-btn cursor-pointer rounded-full border border-signal/40 bg-signal/15 px-4 py-1.5 text-xs font-semibold text-signal transition hover:bg-signal/25"
      >
        Todos
      </button>
      {
        allTags.map((tag) => (
          <button
            type="button"
            data-tag={tag}
            class="tag-filter-btn cursor-pointer rounded-full border border-line bg-white/[0.03] px-4 py-1.5 text-xs font-semibold text-copy-light transition hover:border-signal/30 hover:text-signal"
          >
            {tag}
          </button>
        ))
      }
    </div>

    {/* Articles Grid */}
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      id="articlesGrid"
      data-items-per-page={itemsPerPage}
    >
      {allArticles.map((post) => <BlogCard post={post} />)}
    </div>

    {/* Empty State */}
    <div
      id="noArticlesState"
      class="hidden text-center py-16 text-copy"
    >
      <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-white/[0.04] text-copy">
        <Icon name="lucide:file-question" class="size-6" />
      </div>
      <p class="text-base font-medium text-paper">
        No se encontraron artículos para esta búsqueda.
      </p>
      <p class="mt-1 text-sm text-copy">
        Intenta con otro término o selecciona otra etiqueta.
      </p>
      <button
        type="button"
        id="resetFiltersBtn"
        class="mt-5 inline-flex items-center gap-2 rounded-md border border-line bg-white/[0.04] px-4 py-2 text-xs font-semibold text-paper transition hover:border-signal/40 hover:text-signal cursor-pointer"
      >
        <Icon name="lucide:rotate-ccw" class="size-3.5" />
        Restablecer filtros
      </button>
    </div>

    {/* Pagination */}
    <div
      id="paginationControls"
      class="mt-14 flex items-center justify-center gap-3"
    >
      <button
        type="button"
        id="prevPageBtn"
        class="flex size-10 items-center justify-center rounded-full border border-line bg-white/[0.03] text-copy transition hover:border-signal/40 hover:text-paper disabled:opacity-20 disabled:pointer-events-none cursor-pointer"
        aria-label="Página anterior"
      >
        <Icon name="lucide:chevron-left" class="size-4" />
      </button>

      <div
        class="flex items-center gap-1.5 rounded-full border border-line bg-white/[0.03] px-4 py-2 text-xs font-mono text-copy"
      >
        <span id="currentPageNum" class="font-bold text-paper">1</span>
        <span>/</span>
        <span id="totalPagesNum">1</span>
      </div>

      <button
        type="button"
        id="nextPageBtn"
        class="flex size-10 items-center justify-center rounded-full border border-line bg-white/[0.03] text-copy transition hover:border-signal/40 hover:text-paper disabled:opacity-20 disabled:pointer-events-none cursor-pointer"
        aria-label="Página siguiente"
      >
        <Icon name="lucide:chevron-right" class="size-4" />
      </button>
    </div>
  </div>
</section>

<script>
  function initBlogInteractions() {
    const grid = document.getElementById("articlesGrid");
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".article-card"));
    const searchInput = document.getElementById("blogSearch") as HTMLInputElement | null;
    const tagButtons = document.querySelectorAll<HTMLButtonElement>(".tag-filter-btn");
    const noArticlesState = document.getElementById("noArticlesState");
    const paginationControls = document.getElementById("paginationControls");
    const prevBtn = document.getElementById("prevPageBtn") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("nextPageBtn") as HTMLButtonElement | null;
    const currentNum = document.getElementById("currentPageNum");
    const totalNum = document.getElementById("totalPagesNum");
    const resetBtn = document.getElementById("resetFiltersBtn");

    const itemsPerPage = parseInt(grid.dataset.itemsPerPage || "6", 10);
    let activeTag = "all";
    let searchQuery = "";
    let currentPage = 1;

    // Check URL parameters (e.g. ?tag=Astro or ?q=...)
    const urlParams = new URLSearchParams(window.location.search);
    const initialTag = urlParams.get("tag");
    const initialQ = urlParams.get("q");

    if (initialTag) {
      activeTag = initialTag;
    }
    if (initialQ && searchInput) {
      searchQuery = initialQ;
      searchInput.value = initialQ;
    }

    function updateTagButtonStyles() {
      tagButtons.forEach((btn) => {
        const isSelected = btn.dataset.tag === activeTag;
        if (isSelected) {
          btn.className =
            "tag-filter-btn cursor-pointer rounded-full border border-signal/40 bg-signal/15 px-4 py-1.5 text-xs font-semibold text-signal transition";
        } else {
          btn.className =
            "tag-filter-btn cursor-pointer rounded-full border border-line bg-white/[0.03] px-4 py-1.5 text-xs font-semibold text-copy-light transition hover:border-signal/30 hover:text-signal";
        }
      });
    }

    function filterAndPaginate() {
      const term = searchQuery.toLowerCase().trim();

      // Find matching cards
      const matchingCards = cards.filter((card) => {
        const title = card.dataset.title || "";
        const desc = card.dataset.description || "";
        let tags: string[] = [];
        try {
          tags = JSON.parse(card.dataset.tags || "[]");
        } catch {
          tags = [];
        }

        const matchesSearch = !term || title.includes(term) || desc.includes(term);
        const matchesTag = activeTag === "all" || tags.includes(activeTag);

        return matchesSearch && matchesTag;
      });

      const totalMatches = matchingCards.length;
      const totalPages = Math.max(1, Math.ceil(totalMatches / itemsPerPage));

      if (currentPage > totalPages) {
        currentPage = 1;
      }

      // Hide all first
      cards.forEach((card) => {
        card.style.display = "none";
      });

      // Show matching cards for current page
      const startIdx = (currentPage - 1) * itemsPerPage;
      const endIdx = startIdx + itemsPerPage;
      const visibleCards = matchingCards.slice(startIdx, endIdx);

      visibleCards.forEach((card) => {
        card.style.display = "";
      });

      // Toggle empty state
      if (totalMatches === 0) {
        noArticlesState?.classList.remove("hidden");
        grid?.classList.add("hidden");
        paginationControls?.classList.add("hidden");
      } else {
        noArticlesState?.classList.add("hidden");
        grid?.classList.remove("hidden");

        if (totalPages > 1) {
          paginationControls?.classList.remove("hidden");
          if (currentNum) currentNum.textContent = String(currentPage);
          if (totalNum) totalNum.textContent = String(totalPages);
          if (prevBtn) prevBtn.disabled = currentPage === 1;
          if (nextBtn) nextBtn.disabled = currentPage === totalPages;
        } else {
          paginationControls?.classList.add("hidden");
        }
      }

      updateTagButtonStyles();
    }

    // Event listeners
    searchInput?.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      currentPage = 1;
      filterAndPaginate();
    });

    tagButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeTag = btn.dataset.tag || "all";
        currentPage = 1;
        filterAndPaginate();
      });
    });

    prevBtn?.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        filterAndPaginate();
        const section = document.getElementById("blog-articles");
        section?.scrollIntoView({ behavior: "smooth" });
      }
    });

    nextBtn?.addEventListener("click", () => {
      currentPage++;
      filterAndPaginate();
      const section = document.getElementById("blog-articles");
      section?.scrollIntoView({ behavior: "smooth" });
    });

    resetBtn?.addEventListener("click", () => {
      activeTag = "all";
      searchQuery = "";
      if (searchInput) searchInput.value = "";
      currentPage = 1;
      filterAndPaginate();
    });

    // Run initial filter
    filterAndPaginate();
  }

  initBlogInteractions();
  document.addEventListener("astro:page-load", initBlogInteractions);
</script>
