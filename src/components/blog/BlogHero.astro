---
import { Icon } from "astro-icon/components";
---

<section
  class="relative overflow-hidden border-b border-line bg-ink pt-28 pb-14 sm:pt-36 sm:pb-20"
  id="blog-hero"
>
  <div
    class="surface-grid absolute inset-0 opacity-30 [mask-image:radial-gradient(circle_at_center,black,transparent_70%)] pointer-events-none"
  >
  </div>
  <div
    class="absolute left-1/2 top-0 size-[32rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-electric/15 blur-[130px] pointer-events-none"
  >
  </div>

  <div class="site-container relative z-10 text-center" data-motion="heading">
    <div
      class="inline-flex items-center gap-2 rounded-full border border-signal/30 bg-signal/10 px-3.5 py-1.5 text-xs font-semibold text-signal mb-6"
    >
      <Icon name="lucide:pen-tool" class="size-3.5" />
      Publicaciones Técnicas & Casos Reales
    </div>

    <h1
      class="mx-auto max-w-4xl text-[clamp(2.2rem,5vw,4.5rem)] font-bold tracking-tight leading-[1.08] text-paper mb-6"
    >
      Blog, Arquitectura & <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-signal to-electric"
        >Ingeniería Web</span
      >
    </h1>

    <p
      class="mx-auto max-w-2xl text-base sm:text-lg leading-relaxed text-copy"
    >
      Experiencia práctica, decisiones de diseño y análisis técnicos sobre
      React, Next.js, Laravel, arquitecturas headless, rendimiento web e
      inteligencia artificial aplicada al desarrollo.
    </p>
  </div>
</section>
