---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import type { BlogPostFrontmatter } from "../services/blogService";

interface Props {
  frontmatter: BlogPostFrontmatter;
  rawContent?: () => string;
}

const { frontmatter } = Astro.props;

// Formateo de fecha
const postDate = frontmatter.pubDate || (frontmatter as any).date || "";
const formattedDate = postDate
  ? new Date(postDate).toLocaleDateString("es-AR", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

// Estimación de tiempo de lectura (aproximadamente 200 palabras por minuto)
let readingTime = 5;
if (typeof Astro.props.rawContent === "function") {
  const words = Astro.props.rawContent().split(/\s+/).length;
  readingTime = Math.max(1, Math.ceil(words / 200));
}

const coverSrc = frontmatter.cover ? `/img/${frontmatter.cover}` : null;

const canonicalUrl = new URL(Astro.url.pathname, "https://felixmarquez.dev").href;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: postDate,
  author: {
    "@type": "Person",
    name: frontmatter.author,
    url: "https://felixmarquez.dev/#person",
  },
  publisher: {
    "@type": "Person",
    name: "Félix Márquez",
    url: "https://felixmarquez.dev/",
  },
  keywords: frontmatter.tags?.join(", "),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
});
---

<Layout
  title={`${frontmatter.title} | Blog Félix Márquez`}
  description={frontmatter.description}
  canonical={canonicalUrl}
  ogTitle={frontmatter.title}
  ogDescription={frontmatter.description}
  jsonLd={jsonLd}
>
  <Navbar />
  <main id="contenido" class="flex-1 pt-24">
    {/* Article Hero */}
    <section class="relative overflow-hidden bg-ink py-14 sm:py-20">
      <div
        class="surface-grid absolute inset-0 opacity-25 [mask-image:radial-gradient(circle_at_center,black,transparent_75%)] pointer-events-none"
      >
      </div>
      <div
        class="absolute left-1/2 top-0 size-[32rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-electric/15 blur-[120px] pointer-events-none"
      >
      </div>

      <div class="site-container relative z-10">
        <div class="mx-auto max-w-3xl text-center">
          {/* Breadcrumb / Back button */}
          <div class="mb-8 flex justify-center">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 rounded-full border border-line bg-white/[0.03] px-4 py-1.5 text-xs font-medium text-copy-light transition hover:border-signal/40 hover:text-signal"
            >
              <Icon name="lucide:arrow-left" class="size-3.5" />
              Volver al Blog
            </a>
          </div>

          {/* Tags */}
          {
            frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="mb-6 flex flex-wrap justify-center gap-2">
                {frontmatter.tags.map((tag: string) => (
                  <a
                    href={`/blog?tag=${encodeURIComponent(tag)}`}
                    class="inline-flex items-center rounded-full border border-signal/30 bg-signal/10 px-3 py-1 text-xs font-medium text-signal transition hover:bg-signal/20"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )
          }

          {/* Title */}
          <h1
            class="text-[clamp(1.85rem,4.5vw,3.25rem)] font-bold tracking-tight leading-[1.12] text-paper mb-6"
          >
            {frontmatter.title}
          </h1>

          {/* Meta Info */}
          <div
            class="flex flex-wrap items-center justify-center gap-4 text-xs sm:text-sm text-copy"
          >
            <div class="flex items-center gap-1.5">
              <Icon name="lucide:user" class="size-4 text-signal" />
              <span>{frontmatter.author}</span>
            </div>
            <span class="size-1 rounded-full bg-line"></span>
            <div class="flex items-center gap-1.5">
              <Icon name="lucide:calendar" class="size-4 text-signal" />
              <time datetime={postDate}>{formattedDate}</time>
            </div>
            <span class="size-1 rounded-full bg-line"></span>
            <div class="flex items-center gap-1.5">
              <Icon name="lucide:clock" class="size-4 text-signal" />
              <span>{readingTime} min de lectura</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Cover Image */}
    {
      coverSrc && (
        <section class="bg-ink relative pb-6">
          <div class="site-container">
            <div class="mx-auto max-w-4xl overflow-hidden rounded-2xl border border-line bg-panel shadow-panel">
              <img
                src={coverSrc}
                alt={frontmatter.title}
                class="w-full h-auto object-cover max-h-[500px]"
                loading="eager"
              />
            </div>
          </div>
        </section>
      )
    }

    {/* Article Body */}
    <section class="py-12 sm:py-16 bg-ink relative">
      <div class="site-container">
        <article class="prose-article max-w-3xl mx-auto">
          <slot />
        </article>

        {/* Back to blog footer */}
        <div class="mx-auto max-w-3xl mt-16 pt-8 border-t border-line flex items-center justify-between">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-sm font-medium text-copy-light hover:text-signal transition"
          >
            <Icon name="lucide:arrow-left" class="size-4" />
            Volver al listado de artículos
          </a>
          <a
            href="#contenido"
            class="inline-flex items-center gap-2 text-sm text-copy hover:text-paper transition"
          >
            Subir al inicio
            <Icon name="lucide:arrow-up" class="size-4" />
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* Estilos de Prosa para Artículos */
  .prose-article {
    color: var(--color-copy-light);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .prose-article p {
    margin-bottom: 1.35rem;
    color: var(--color-copy-light);
  }

  .prose-article h2 {
    color: var(--color-paper);
    font-weight: 700;
    font-size: 1.75rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
    line-height: 1.25;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.75rem;
  }

  .prose-article h3 {
    color: var(--color-paper);
    font-weight: 700;
    font-size: 1.35rem;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .prose-article h4 {
    color: var(--color-paper);
    font-weight: 600;
    font-size: 1.15rem;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose-article strong {
    color: var(--color-paper);
    font-weight: 600;
  }

  .prose-article em {
    color: #e2e8f0;
    font-style: italic;
  }

  .prose-article a {
    color: var(--color-signal);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }

  .prose-article a:hover {
    color: var(--color-paper);
  }

  .prose-article ul {
    padding-left: 1.5rem;
    margin-bottom: 1.35rem;
    list-style-type: disc;
  }

  .prose-article ol {
    padding-left: 1.5rem;
    margin-bottom: 1.35rem;
    list-style-type: decimal;
  }

  .prose-article li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .prose-article li::marker {
    color: var(--color-signal);
  }

  /* Listas de tareas / Checklists */
  .prose-article ul:has(input[type="checkbox"]) {
    list-style: none;
    padding-left: 0;
  }

  .prose-article li:has(input[type="checkbox"]) {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .prose-article input[type="checkbox"] {
    accent-color: var(--color-signal);
    width: 1.05rem;
    height: 1.05rem;
    margin: 0;
    cursor: pointer;
  }

  .prose-article blockquote {
    border-left: 4px solid var(--color-signal);
    padding: 0.85rem 1.25rem;
    margin: 1.75rem 0;
    color: var(--color-copy);
    font-style: italic;
    background: rgba(16, 22, 32, 0.5);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .prose-article code:not(pre code) {
    background: var(--color-panel-light);
    color: var(--color-signal);
    border: 1px solid var(--color-line);
    padding: 0.15rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.88em;
    font-family: var(--font-mono);
  }

  .prose-article pre {
    background: var(--color-ink-soft);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin: 1.75rem 0;
    overflow-x: auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .prose-article pre code {
    background: transparent;
    border: 0;
    color: var(--color-paper);
    padding: 0;
    font-size: 0.9em;
    line-height: 1.6;
    font-family: var(--font-mono);
  }

  .prose-article hr {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin: 2.5rem 0;
  }

  .prose-article img {
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    margin: 2rem 0;
    width: 100%;
    height: auto;
  }

  /* ------------------------------------------------------------- */
  /* TABLAS MODERNAS MODO OSCURO                                  */
  /* ------------------------------------------------------------- */
  .table-wrapper {
    width: 100%;
    margin: 2rem 0;
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: rgba(16, 22, 32, 0.5);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }

  .prose-article table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.925rem;
    margin: 0;
  }

  .prose-article thead {
    background: var(--color-panel-light);
    border-bottom: 2px solid var(--color-line);
  }

  .prose-article th {
    padding: 0.9rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    white-space: nowrap;
  }

  .prose-article th:first-child {
    border-right: 1px solid var(--color-line);
  }

  .prose-article td {
    padding: 0.9rem 1.25rem;
    color: var(--color-copy-light);
    border-bottom: 1px solid rgba(32, 42, 56, 0.5);
    line-height: 1.6;
    vertical-align: middle;
  }

  .prose-article td:first-child {
    font-weight: 600;
    color: var(--color-paper);
    border-right: 1px solid rgba(32, 42, 56, 0.4);
    background: rgba(255, 255, 255, 0.015);
    white-space: nowrap;
  }

  .prose-article tbody tr:last-child td {
    border-bottom: none;
  }

  .prose-article tbody tr {
    transition: background-color 0.15s ease;
  }

  .prose-article tbody tr:hover {
    background: rgba(255, 255, 255, 0.025);
  }
</style>

<script>
  function wrapTables() {
    document.querySelectorAll(".prose-article table").forEach((table) => {
      if (!table.parentElement?.classList.contains("table-wrapper")) {
        const wrapper = document.createElement("div");
        wrapper.className = "table-wrapper";
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      }
    });
  }

  wrapTables();
  document.addEventListener("astro:page-load", wrapTables);
</script>

